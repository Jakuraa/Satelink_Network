# Ignore local env files — Railway injects vars directly
.env
.env.*
!.env.example

# Ignore local node_modules — container does npm install
node_modules/

# Ignore logs and temp files
logs/
*.log
.DS_Store

# Ignore test files
test/
*.test.js

# ── P0 2026-11-04: never ship database dumps, backups or env files ──
*.dump
*.pgdump
*.backup
*.sql.gz
*.bak.sql
backups/
docs/release/**/*.dump
.env
.env.*
!.env.example
**/*.dump
**/*.pgdump
**/*.backup
**/*.sql.gz
**/*.bak.sql
**/backups/
**/.env
**/.env.*
!**/.env.example
