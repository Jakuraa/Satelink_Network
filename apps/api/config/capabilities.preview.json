      ],
      "connector_type": "rest",
      "interface_meta": {
        "rest": {
          "base": "https://openrouter.ai/api/v1",
          "auth": "OPENROUTER_API_KEY (optional; fixture without it)"
        }
      },
      "skill_refs": [],
      "credential_requirements": [
        "OPENROUTER_API_KEY (optional)"
      ],
      "permission_scope": "assistant:chat",
      "markets": [
        "GLOBAL"
      ],
      "currencies": [
        "USD"
      ],
      "price_model": {
        "kind": "metered_tokens",
        "source": "upstream usage.cost"
      },
      "fee_policy_id": "inference_markup_20pct",
      "commercial_rights": {
        "resale_allowed": null,
        "terms_url": "https://openrouter.ai/terms",
        "evidence": "Not reviewed — founder action before live use."
      },
      "security_class": "untrusted_output",
      "timeout_ms": 30000,
      "idempotency": {
        "required": false
      },
      "retry": {
        "max_attempts": 1,
        "on": []
      },
      "verification": {
        "method": "response_contract",
        "evidence_fields": [
          "served_by",
          "generation_id"
        ]
      },
      "refund_policy": "Preview: inference cost is simulated and never charged.",
      "availability": "fixture_without_key",
      "release_status": "PREVIEW",
      "environment": "preview",
      "internal_only": true,
      "last_verified_at": null,
      "last_verified_evidence": "apps/api/test/model_router.test.js (fixture)"
    },
    {
      "id": "food.order.place",
      "version": 1,
