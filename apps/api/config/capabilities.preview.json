      "input_schema": {
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "maxItems": 50
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "text",
          "served_by"
